<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EnglishLearningApp" parent="Theme.Material3.Light">
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="android:colorForeground">@color/foreground_light</item>
    </style>

    <style name="Theme.EnglishLearningApp.NoActionBar" parent="Theme.EnglishLearningApp">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowFullscreen">false</item>
        <item name="windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.EnglishLearningApp.Dark" parent="Theme.Material3.Dark">
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="android:colorForeground">@color/foreground_dark</item>
    </style>
</resources>
